# Gemini API Key (server-side only — strictly 1 call per calendar day)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Primary Daily Cache & Distributed Lock (Vercel Marketplace -> Upstash Redis / Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Fallback Store (server-side JSONBin if Upstash is not configured)
JSONBIN_BIN_ID=
JSONBIN_API_KEY=

# Optional Security Secrets for Vercel Cron & Owner Regeneration Endpoint
CRON_SECRET=
ADMIN_SECRET=
